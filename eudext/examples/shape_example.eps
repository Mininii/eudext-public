// eudext.shape 예제 — DESIGN 4.13 (CX Paint 도형 → 좌표표)
// 빌드: python eudext/tools/build.py euddraft eudext/examples/shape_example.eds --work <작업 폴더>
// 도형 계산은 컴파일 시점(lupa 로 CB Paint v2.5 를 그대로 실행)이고, 맵에는 좌표표만 실린다(점 하나 4B).
// 상수 도형 번호·점 번호는 파이썬 값으로 접힌다(트리거 0). 변수면 주소표·좌표표를 읽는다.
import eudext.shape as shape;

const cx = shape.CX(seed=1234);                                      // lib_dir 기본 = 저장소 reference/MapSource/Library
const ring = cx.call("CSMakeCircle", 6, 32, 0, 37, 0);               // 0° = 12시, 시계 방향 (첫 껍질 첫 점 (0, -32))
const star = cx.eval("CSMakeStar(5, 144, 96, 0, CS_Level('Star', 5, 3), 0)");
const fade = ring.sweep("right", px_per_cycle=32);                   // 왼→오 정렬 + 스케줄 (5, 8, 9, 6, 5, 4)
const dots = shape.Shape.from_flat(list(0, 0, 16, -16, -3, 5));      // epScript 의 list 는 중첩이 풀리므로 평평하게
const shapes = shape.ShapeSet(list(ring, star, fade, dots));         // sid 0 ~ 3
const packed = shape.ShapeSet(list(ring, dots), storage="varray");   // 점 하나 144B, 읽기가 빠르다

var sid, idx, px, py, n, vx, vy, band0, bands, cnt2, frame, star3;

function afterTriggerExec() {
    frame += 1;
    n = shapes.count(sid);                          // 변수 sid: 주소표 (범위 밖이면 0)
    const x, y = shapes.point_at(sid, idx);         // 편향을 뺀 부호 있는 좌표
    px = x;
    py = y;
    const a, b = packed.point_at(1, idx % 3);       // dots: (0,0) (16,-16) (-3,5)
    vx = a;
    vy = b;
    const st, c2, sc = shapes.lookup(2);            // 상수 sid 는 상수식
    cnt2 = c2;
    bands = dwread_epd(sc);                         // 스케줄 칸 0 = 밴드 수
    band0 = dwread_epd(sc + 1);                     // 첫 사이클 점 수
    const sx, sy = shapes.point_at(1, 3);           // 상수 → 파이썬 정수 (56, -18)
    star3 = sx * 1000 + sy;
    if (frame == 1) {
        printAll("\x07[shape] 도형 {} 개, 원 점 {}, 별 점 {}", 4, shapes.count(0), shapes.count(1));
    }
}
