:: eudext.mathx 예제 빌드 설정 (euddraft 0.11.0.1)
:: 저장소 밖에서 빌드한다: python eudext/tools/build.py euddraft eudext/examples/mathx_example.eds --work <작업 폴더>
:: (이 폴더에서 바로 빌드하면 mathx_example_out.scx 와 __epspy__ 가 여기에 생긴다.)
:: eds 줄에는 끝 주석을 달 수 없다. 주석 줄은 '::' 로 시작한다. 경로는 '/' 로 쓴다.

[main]
input : ../testing/base.scx
output : mathx_example_out.scx

[../boot.py]
EudextRoot : ../..
Preload : mathx

[mathx_example.eps]

[freeze]
freeze : 0
