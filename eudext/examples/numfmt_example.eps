// eudext.numfmt 예제 (epScript) — DESIGN 0.3 의 printAll 모양 + 시험(tests/t_numfmt.py)이 부르는 함수들
// 빌드: python eudext/tools/build.py euddraft eudext/examples/numfmt_example.eds --work <작업 폴더>
//
// 규칙 (DESIGN 3.2-7·3.11·4.6):
//  - 서식 객체(nf.Dec/Hex/Man/Per/Gauge, nf.dp.*)는 인쇄 함수(printAll, dbstr_print, sprintf, StringBuffer)에 그대로 넘긴다.
//    인쇄하는 순간 값을 읽어 그 자리 버퍼에 서식 문자열을 만든다. 만들 때는 트리거가 없다.
//  - 파이썬 함수의 키워드 인자는 번역된다: nf.Dec(mp, width=5, fill="0").
//  - 목록 인자는 list(a, b) 로 쓴다(리스트 리터럴 [a, b] 는 EUDArray 로 번역된다): group=list(3, ",").
//  - 객체를 const 에 담아 두고 여러 번 인쇄해도 된다(인쇄마다 그 자리에서 변환).
//  - TextFX(StringBuffer.fadeIn 등)에는 obj.fmt() 결과를 넘긴다(객체를 그대로 넘기면 빌드 오류로 안내).
import eudext.numfmt as nf;
import eudext.i64 as i64;

var mp;
const gold = i64.Int64(12800000000);
const mpText = nf.Dec(mp, width=5, fill="0");

function afterTriggerExec() {
    mp += 7;
    if (mp >= 7) {
        printAll("MP {}", nf.Dec(mp, width=5, fill="0"));          // DESIGN 0.3 그대로
        printAll("골드 {} = {}", nf.Dec(gold, group=list(3, ",")), nf.Man(gold, colors="dps", after=0x04));
    }
}

// ---- 시험용 함수 ----

function dec_to(buf, v) {                     // "[00042|42|42|４２]" (부호 있게 읽은 값·묶음·전각)
    dbstr_print(buf, "[", nf.Dec(v, width=5, fill="0"), "|", nf.Dec(v, sign="-"), "|",
        nf.Dec(v, group=list(3, ",")), "|", nf.Dec(v, fullwidth=True), "]");
}

function hex_to(buf, v) {                     // sprintf 로도 된다
    sprintf(buf, "{}/{}", nf.Hex(v), nf.Hex(v, width=0, lower=True));
}

function man_to(buf, lo, hi) {                // 64비트 만 단위와 DisplayPrint 호환 18B
    const x = i64.wrap(lo, hi);
    dbstr_print(buf, nf.Man(x), "|", nf.dp.man18(x, color=True));
}

function per_to(buf, v) {                     // 소수점·per8·막대
    dbstr_print(buf, nf.Per(v, max=100000), "|", nf.dp.per8(v), "|", nf.Gauge(v, cells=5));
}

function two_to(buf, a, b) {                  // fmt() 를 먼저 두 번 불러도 자리마다 버퍼가 따로다
    const x = nf.Dec(a).fmt();
    const y = nf.Dec(b, sign="+-").fmt();
    dbstr_print(buf, x, " ", y);
}

function const_to(buf) {                      // const 에 담은 객체 — 인쇄 순간의 mp 를 읽는다
    dbstr_print(buf, mpText);
}

function cells_roundtrip(cells, v) {          // 글자 셀로 쓰고 다시 읽기 (CD__ScanV 대체)
    const n = nf.fmt_dec_cells(EPD(cells), v, color=0x1F, sign="-", group=list(3, ","));
    return nf.scan_dec_cells(EPD(cells), n, signed=True);
}

function write_to(dst, v) {                   // NUL 없이 바로 쓰고 쓴 길이를 돌려준다
    return nf.fmt_dec_to(dst, v, sign="-");
}
