// eudext.chat·textfx 인게임 확인 맵 — docs/INGAME_CHECKLIST.md 의 D17-* 항목 (조각: WP17 ingame.md)
// 빌드: python eudext/tools/build.py euddraft eudext/examples/chat_ingame.eds --work <작업 폴더>
// 혼자(P1) 연다. 줄머리 [D17-번호] 가 체크리스트 항목이다. 화면을 영상(가능하면)·사진이나 글로 알려 주면 된다.
//
// 진행 (게임 속도 "가장 빠름" = 초당 24프레임 기준):
//   1초  [D17-0] 안내 (보통 줄)
//   2초  [D17-1] 가운데 정렬 줄이 한 글자씩 나타난다 (!H 는 끝까지 보이지 않아야 한다)
//   5초  [D17-2] 세 줄짜리 문구 — 짝수·홀수 slot 에 걸쳐 모두 한 글자씩
//   8초  [D17-3] 2바이트 UTF-8(é ñ ü ß ç ø Ω)이 깨지지 않아야 한다
//  12초  [D17-4] 보통 줄의 212바이트 NUL 자르기 — 콜론 뒤 글자 수(짝수 slot 12, 홀수 slot 14)
//  15초  [D17-5] 52칸 한도 — 숫자가 ...890123 에서 끝나야 한다
//  18초  [D17-6] 채팅 시험 안내 — 채팅으로 "!H안녕 éè 가나다" 를 보내면 그 줄이 한 글자씩 다시 나와야 한다(언제든)
//  40초  [D17-7] 소리 판(2프레임에 한 글자, 글자마다 딸깍, 공백은 조용)으로 바뀐다
//  45초  [D17-8] 줄 사라짐 안내 — 효과가 끝난 줄도 보통 채팅처럼 시간이 지나면 사라져야 한다
//
// 채팅 시험(D17-6) 방법: 사용자 채팅 줄은 원문 앞에 이름이 붙어 표식("\r\r!H")으로 시작하지 않는다. 그래서 이 맵은
// 새 줄에서 "!H" 를 찾으면 그 앞(이름 부분)을 지우고 "\r\r!H…" 로 줄을 당겨 쓴다(로컬, 표시 전용) → 타자기가 변환한다.
// 그때 원문 앞 12바이트를 16진으로 한 줄 띄운다(SC:R 채팅 줄 바이트 배치 확인용 — 사진으로 보내 주면 된다).
import eudext.chat as chat;
import eudext.local as local;

var phaseA = 1;                                   // 0~40초 = 타자기 A, 그 뒤 = 타자기 B (둘이 같은 프레임에 돌지 않게)
var phaseB = 0;
const fast = chat.Typewriter(enable=phaseA);     // 기본: 1프레임 1글자, 소리 없음, 11줄 셀 53 NUL
const slow = chat.Typewriter(enable=phaseB, every=2, sound="sound\\glue\\bnetclick.wav");
var frame, lastNext, relayed;

const LONG_EVEN = "\x04[D17-4] even slot: expect 12 chars after colon: " + "\x04" * 151 + "0123456789ABCDEF";
const LONG_ODD = "\x04[D17-4] odd slot: expect 14 chars after colon: " + "\x04" * 152 + "0123456789ABCDEF";

function relayLine(s) {
    const p = chat.line_ptr(s);
    var i = 2;
    while (i < 60) {
        const b = bread(p + i);
        if (b == 0) break;
        if (b == 0x21 && bread(p + i + 1) == 0x48) {
            if (i == 2) break;                    // 이미 표식으로 시작하는 줄(맵이 띄운 문구)
            printAll("\x04[D17-6] 채팅 줄 원문 앞 12바이트 {:x} {:x} {:x} / 표식 위치 {}", dwread(p), dwread(p + 4), dwread(p + 8), i);
            memcpy(p + 2, p + i, 216 - i);        // "!H…" 를 앞으로 당긴다 (겹쳐도 앞쪽으로 옮기므로 안전)
            bwrite(p, 13);
            bwrite(p + 1, 13);
            bwrite(p + 217, 0);
            relayed += 1;
            break;
        }
        i += 1;
    }
}

function relay() {
    const nxt = dwread(0x640B58);
    var s = lastNext;
    var guard = 0;
    while (s != nxt && guard < 11) {
        relayLine(s);
        s += 1;
        if (s == 11) s = 0;
        guard += 1;
    }
    lastNext = nxt;
}

function afterTriggerExec() {
    if (frame == 24) { DoActions(DisplayTextAll("\x04[D17-0] eudext 채팅 확인 맵 — 줄머리 [D17-n] 을 보고 알려 주세요")); }
    if (frame == 48) { DoActions(DisplayTextAll(fast.mark("\x13\x04[D17-1] 가운데 정렬 — 한 글자씩: 가나다라마바사 ABC"))); }
    if (frame == 120) {
        DoActions(DisplayTextAll(fast.mark("\x07[D17-2] 첫째 줄 (짝·홀 slot)\n\x1f[D17-2] 둘째 줄\n\x04[D17-2] 셋째 줄 — 모두 표식 없이")));
    }
    if (frame == 192) { DoActions(DisplayTextAll(fast.mark("\x04[D17-3] 2바이트 UTF-8: é ñ ü ß ç ø Ω — 깨지지 않으면 정상"))); }
    if (frame == 288) {
        local.begin();
        const nx = dwread(0x640B58);             // 이 줄이 들어갈 slot 의 홀짝
        if (nx % 2 == 0) { DoActions(DisplayTextAll(LONG_EVEN)); } else { DoActions(DisplayTextAll(LONG_ODD)); }
        local.end();
    }
    if (frame == 360) { DoActions(DisplayTextAll(fast.mark("\x04[D17-5] 52칸 한도: " + "0123456789" * 6))); }
    if (frame == 432) {
        DoActions(DisplayTextAll("\x04[D17-6] 채팅으로 \x07!\x07H안녕 éè 가나다\x04 를 보내 보세요 — 한 글자씩 다시 나오면 정상"));
    }
    if (frame == 960) {
        phaseA = 0;
        phaseB = 1;
        DoActions(DisplayTextAll(slow.mark("\x04[D17-7] 소리 판: 2프레임에 한 글자, 글자마다 딸깍, 공백은 조용")));
    }
    if (frame == 1080) { DoActions(DisplayTextAll(slow.mark("\x04[D17-8] 끝난 줄도 시간이 지나면 보통 채팅처럼 사라지면 정상"))); }

    local.begin();                                // 채팅 버퍼 읽기·고치기는 이 PC 에서만 (표시 전용)
    relay();
    local.end();
    fast.tick();
    slow.tick();
    frame += 1;
}
