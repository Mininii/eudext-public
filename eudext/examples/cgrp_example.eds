:: eudext.cgrp 예제 (epScript)
:: 빌드: python eudext/tools/build.py euddraft eudext/examples/cgrp_example.eds --work <작업 폴더>
:: CtrigAsm 가이드북: CGRP 는 언리미터 필수 → [unlimiter] (euddraft 0.11 동봉)

[main]
input : ../testing/base.scx
output : cgrp_example_out.scx

[../boot.py]
EudextRoot : ../..
Preload : bullet, cgrp

[unlimiter]

[cgrp_example.eps]

[freeze]
freeze : 0
